# ─────────────────────────────────────────────────────────────────
# Williams Quantum agent core — ALL vars are WQ_-prefixed so this
# backend can share a Node process with the SuperSpeech service
# without ever colliding with its environment.
#
# Mounted mode: set these as env vars on the shared Render service.
# Standalone mode: run `node src/server.js` with these in .env.
# ─────────────────────────────────────────────────────────────────

# Standalone-only (ignored when mounted inside another app)
WQ_PORT=8080

# AI provider — optional: falls back to shared ANTHROPIC_API_KEY /
# OPENHANDS_API_KEY on the host when unset (same billing is intended)
WQ_ANTHROPIC_API_KEY=
WQ_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Spacemail - corporate inbox (products@williamsquantum.com)
WQ_EMAIL_FROM=products@williamsquantum.com
WQ_EMAIL_FROM_NAME=Williams Quantum
WQ_EMAIL_HOST=mail.spacemail.com
WQ_EMAIL_PORT=587
WQ_EMAIL_SECURE=false
WQ_EMAIL_USER=products@williamsquantum.com
WQ_EMAIL_PASSWORD=

# IMAP polling for inbound replies (same inbox)
WQ_IMAP_HOST=mail.spacemail.com
WQ_IMAP_PORT=993
WQ_IMAP_POLL_INTERVAL_MS=120000

# Principal approvals - comma-separated; the FIRST address receives
# contract-gate escalations and can reply "Approved"/"Rejected"
WQ_APPROVER_EMAILS=

# Daily play trigger time, Europe/London
WQ_AGENT_HOUR=9
WQ_AGENT_MINUTE=30

# Feature switches
WQ_ENABLE_IMAP_POLLING=true
WQ_ENABLE_AGENT=true

# Shared key guarding /api/* routes (?key= works for browser views)
WQ_API_SECRET_KEY=

# Optional: durable JSON store path (attach a Render Disk for persistence)
# WQ_STORE_FILE=/var/data/wq-store.json
